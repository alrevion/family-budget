{
  "name": "family-budget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && tsc -p app/tsconfig.json && vitest run",
    "migrate": "wrangler d1 migrations apply family-budget-db --local",
    "build": "npm run build:app",
    "build:app": "node scripts/build.mjs && tsc -p app/tsconfig.json"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@telegram-apps/init-data-node": "^2.0.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
